<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Book Test Drive</title>

    <link rel="stylesheet" href="testdrive.css">

</head>

<body>
    
    <nav>

        <div class="logo">BMW</div>

        <ul>
            <li><a href="home.ejs">Home</a></li>
            <li><a href="search.ejs">Search now</a></li>
            <li><a href="testdrive.ejs">Request Test Drive</a></li>
            <li><a href="configure.ejs">Configure & Price</a></li>
        </ul>

    </nav>

    <section class="test-drive">

        <div class="container">

            <h1>Which vehicle would you like to test drive?</h1>

            <p class="subtitle">
                Complete your details below and your BMW Dealer will be in touch shortly to arrange a test drive.
            </p>

            <p class="mandatory">
                * Mandatory fields
            </p>

            <!-- Vehicle -->

            <div class="form-group">
                <select>
                    <option>Series*</option>
                    <option>BMW X1</option>
                    <option>BMW X3</option>
                    <option>BMW X5</option>
                </select>
            </div>

            <div class="form-group">
                <select>
                    <option>Model*</option>
                    <option>X1 sDrive18i</option>
                    <option>X1 xDrive20d</option>
                </select>
            </div>


            <h2>Contact details.</h2>

            <label class="label">SALUTATION*</label>

            <div class="radio-group">

                <label>
                    <input type="radio" name="salutation">
                    Mr
                </label>

                <label>
                    <input type="radio" name="salutation">
                    Ms
                </label>

            </div>


            <div class="form-group">
                <input type="text" placeholder="First Name*">
            </div>

            <div class="form-group">
                <input type="text" placeholder="Last Name*">
            </div>

            <div class="form-group">
                <input type="email" placeholder="Email*">
            </div>

            <div class="form-group">
                <input type="tel" placeholder="Mobile Number*">
            </div>


            <h2>Please select your current city.</h2>

            <div class="form-group">
                <select>
                    <option>City*</option>
                    <option>Mumbai</option>
                    <option>Delhi</option>
                    <option>Pune</option>
                    <option>Bangalore</option>
                </select>
            </div>


            <h2>I am interested in</h2>

            <label class="label">FINANCING</label>

            <div class="toggle">

                <input type="checkbox" id="finance">

                <label for="finance"></label>

                <span>Not interested</span>

            </div>


            <div class="terms">

                <input type="checkbox">

                <p>
                    I accept the
                    <a href="#">Terms and Conditions.</a>
                </p>

            </div>

            <button class="submit-btn">
                Submit request
            </button>

        </div>

    </section>

        <footer>

        <div class="footer-grid">

            <div>

                <h3>Contact & Info</h3>

                <ul>

                    <li><a href="#">Customer Support</a></li>
                    <li><a href="#">Online Genius</a></li>
                    <li><a href="#">Accident Support</a></li>

                </ul>

            </div>

            <div>

                <h3>Assistance & Services</h3>

                <ul>

                    <li><a href="#">Book Service</a></li>
                    <li><a href="#">BMW App</a></li>
                    <li><a href="#">Connected Drive</a></li>

                </ul>

            </div>

            <div>

                <h3>Models</h3>

                <ul>

                    <li><a href="#">BMW X Series</a></li>
                    <li><a href="#">BMW 7 Series</a></li>
                    <li><a href="#">BMW 5 Series</a></li>

                </ul>

            </div>

            <div>

                <h3>Choose & Buy</h3>

                <ul>

                    <li><a href="#">Build Your Own</a></li>
                    <li><a href="search.html">Search Cars</a></li>
                    <li><a href="test-drive.html">Test Drive</a></li>

                </ul>

            </div>

        </div>

        <div class="copy">

            © 2026 BMW. All Rights Reserved.

        </div>

    </footer>
</body>

</html>